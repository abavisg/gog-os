  "autoMode": {
    "allow": [
      "$defaults",
      "Reading, searching and summarising anything inside this repository.",
      "Creating or editing files under life/ and me/. That is the working medium of this system and git keeps every version.",
      "Running the gogos modules (python -m gogos.<module>) and the helpers in .claude/scripts/ (health-check.sh, run-tests.sh, permission-check.sh, banner.sh). Fetching is read-only; the gated write-back paths are covered by ask rules.",
      "Read-only git inspection, plus git add, git commit and branch switching in this repo."
    ],
    "soft_deny": [
      "$defaults",
      "Deleting any file, anywhere. Every rm form is gated by an ask rule; life/inbox/ is gitignored, so a deleted digest cannot be recovered from git.",
      "Pushing to any remote, and any rewrite of git history (reset --hard, rebase, amend, force push).",
      "Applying Gmail write-back (gmail_apply apply, gmail_undo, gmail_loop) without the owner approving that batch in the same turn.",
      "Editing files outside this repository."
    ],
    "hard_deny": [
      "$defaults",
      "Any direct gog call, Google API call or OAuth flow outside the connectors and the gated apply engine in gogos/. The assistant never talks to Google itself.",
      "Any write to GitHub other than the pull request flow for this repo (create, ready, merge, close), which asks each time: no issues, releases, workflow runs, labels, secrets, or non-GET API calls.",
      "Sending anything outward on the owner's behalf (email, messages, calendar invites, webhooks) unless the owner has confirmed that exact send in the same turn.",
      "Reading, printing, copying or otherwise pulling the contents of any credential store into context: OAuth tokens under .core/storage/auth/, .core/config/secrets/, credentials.json, .env files, ~/.ssh, ~/.aws, gh's token store, keys and certificates, the macOS keychain, or a dump of the environment."
    ],
    "environment": [
      "$defaults",
      "This repo is a personal operating system. life/ and me/ hold the owner's memory and profile and are tracked in a private repo; life/inbox/ and .core/storage/ are gitignored and may hold mail bodies.",
      "The human decides; the assistant assists. Nothing leaves the machine without explicit confirmation in the same turn."
    ]
  }
}
