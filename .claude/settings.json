{
  "env": {
    "CLAUDE_CODE_TASK_LIST_ID": "gogos"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ -x .venv/bin/python ] && .venv/bin/python -m gogos.system.start_day --nudge || true"
          }
        ]
      }
    ]
  }
}
